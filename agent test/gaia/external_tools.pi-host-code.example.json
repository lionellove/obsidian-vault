      "args": [
        "run",
        "--rm",
        "-i",
        "mcp/playwright@sha256:8771dc4666e7c11440bfc6a0c6b00480e9a15b8891b45f29a52d7d995f8d1492"
      ]
    },
    {
      "name": "time",
      "transport": "stdio",
